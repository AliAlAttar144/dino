@inherits LayoutComponentBase

<a class="skip-link" href="#main">Naar inhoud</a>
<header class="topbar">
    <div class="topbar__inner">
        <a class="brand" href="/" aria-label="Toetsr – naar overzicht">
            <Logo />
            <span>Toetsr</span>
        </a>
        <nav class="topnav" aria-label="Hoofdmenu">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="list" /><span>Toetsen</span></NavLink>
            <NavLink href="/importeren"><Icon Name="upload" /><span>Importeren</span></NavLink>
            <NavLink href="/beheer/nieuw"><Icon Name="plus" /><span>Nieuwe toets</span></NavLink>
        </nav>
        <div class="topbar__spacer"></div>
    </div>
</header>

<main id="main">
    @Body
</main>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
    Er ging iets mis.
    <a href="." class="reload">Pagina herladen</a>
    <span class="dismiss" role="button" aria-label="Sluiten">✕</span>
</div>
