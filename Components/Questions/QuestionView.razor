@* Eén vraag zoals in de toets: kop, punten, nummer, tekst, afbeelding, invoer en (bij nakijken) uitleg. *@
@{
    var entry = QuestionComponents.For(Question.Type);
    var parameters = new Dictionary<string, object?>
    {
        [nameof(QuestionInputBase.Question)] = Question,
        [nameof(QuestionInputBase.Selected)] = Selected,
        [nameof(QuestionInputBase.Review)] = Review,
        [nameof(QuestionInputBase.Disabled)] = Disabled,
        [nameof(QuestionInputBase.ShowOptionPoints)] = ShowOptionPoints,
        [nameof(QuestionInputBase.IdPrefix)] = IdPrefix,
        [nameof(QuestionInputBase.OnSelect)] = OnSelect,
        [nameof(QuestionInputBase.CursorOptionId)] = CursorOptionId,
    };
    var anchor = $"{IdPrefix}-vraag-{Number}";
}
<section class="question" id="@anchor" aria-labelledby="@($"{anchor}-label")">
    @if (ShowTitle && !string.IsNullOrWhiteSpace(Question.Title))
    {
        <h2 class="question-section">@Question.Title</h2>
    }
    <div class="question-grid">
        <div class="question-points" title="Punten">@Question.Points.ToString("0.0#")p</div>
        <div class="question-number" id="@($"{anchor}-label")"><span class="sr-only">Vraag </span>@Number</div>
        <div class="question-body">
            @if (!entry.RendersText)
            {
                <Markdown Text="@Question.Text" Class="question-text" />
            }
            @if (!string.IsNullOrEmpty(Question.ImagePath))
            {
                <div class="question-image"><img src="@ImageStore.Url(Question.ImagePath)" alt="Afbeelding bij vraag @Number" loading="lazy" /></div>
            }

            <DynamicComponent Type="entry.Component" Parameters="parameters" />

            @if (Review && Result is not null && Feedback)
            {
                var ok = Result.State == ResultState.Correct;
                var partial = Result.State == ResultState.Partial;
                <div class="feedback @(ok ? "ok" : partial ? "partial" : "bad")" role="status" aria-live="polite">
                    <Icon Name="@(ok ? "check" : "x")" />
                    <strong>@(ok ? "Goed!" : partial ? "Deels goed" : Result.State == ResultState.Unanswered ? "Niet beantwoord" : "Fout")</strong>
                    <span class="subtle">@Result.Score.ToString("0.0#") / @Result.MaxScore.ToString("0.0#") punten</span>
                </div>
            }
            else if (Review && Result is not null)
            {
                <div class="row mt-1">
                    <ResultBadge State="Result.State" />
                    <span class="subtle">@Result.Score.ToString("0.0#") / @Result.MaxScore.ToString("0.0#") punten</span>
                </div>
            }
            @if (Review && ShowExplanation && !string.IsNullOrWhiteSpace(Question.Explanation))
            {
                <div class="explanation">
                    <strong class="label-sm">Uitleg</strong>
                    <Markdown Text="@Question.Explanation" />
                </div>
            }
            @if (!Review && OnCheck.HasDelegate)
            {
                <div class="row mt-1">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanCheck)" @onclick="OnCheck">Controleer antwoord</button>
                </div>
            }
            @if (KeyHint is not null)
            {
                <div class="key-hint">@((MarkupString)KeyHint)</div>
            }
            @if (!Review && OnClear.HasDelegate && Selected.Count > 0)
            {
                <button type="button" class="btn btn-ghost btn-sm clear-answer" @onclick="OnClear" disabled="@Disabled">Antwoord wissen</button>
            }
            @if (StatusText is not null)
            {
                <div class="saved-status" aria-live="polite">@StatusText</div>
            }
        </div>
        <div class="question-aside">
            @if (!Review && OnToggleFlag.HasDelegate)
            {
                <button type="button" class="flag-btn" aria-pressed="@(Flagged ? "true" : "false")"
                        title="@(Flagged ? "Markering verwijderen" : "Markeer om later terug te komen")"
                        aria-label="@(Flagged ? $"Markering vraag {Number} verwijderen" : $"Vraag {Number} markeren")"
                        @onclick="OnToggleFlag">
                    <Icon Name="@(Flagged ? "bookmark-filled" : "bookmark")" />
                </button>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;
    [Parameter] public int Number { get; set; }
    [Parameter] public IReadOnlyList<int> Selected { get; set; } = [];
    [Parameter] public bool Review { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public QuestionResult? Result { get; set; }
    [Parameter] public bool ShowExplanation { get; set; } = true;
    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public bool ShowOptionPoints { get; set; }
    [Parameter] public bool Flagged { get; set; }
    [Parameter] public string IdPrefix { get; set; } = "q";
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public EventCallback<OptionSelection> OnSelect { get; set; }
    [Parameter] public EventCallback OnToggleFlag { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    /// <summary>Directe feedback tijdens de toets: grote goed/fout-melding i.p.v. het kleine label.</summary>
    [Parameter] public bool Feedback { get; set; }
    [Parameter] public EventCallback OnCheck { get; set; }
    [Parameter] public bool CanCheck { get; set; }
    [Parameter] public int? CursorOptionId { get; set; }
    /// <summary>Korte uitleg van de toetsen (HTML met &lt;kbd&gt;).</summary>
    [Parameter] public string? KeyHint { get; set; }
}
