@* Bevestigingsdialoog. Gebruik: if (await confirm.AskAsync("Titel", "Tekst", "Verwijderen")) { ... } *@
<Modal IsOpen="_open" Title="@_title" OnClose="() => Resolve(false)">
    <ChildContent>
        <p class="mb-0">@_message</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">Annuleren</button>
        <button type="button" class="btn @(_danger ? "btn-danger" : "btn-primary")" @onclick="() => Resolve(true)">@_confirmText</button>
    </Footer>
</Modal>

@code {
    private bool _open;
    private string _title = "";
    private string _message = "";
    private string _confirmText = "OK";
    private bool _danger;
    private TaskCompletionSource<bool>? _tcs;

    public Task<bool> AskAsync(string title, string message, string confirmText = "Verwijderen", bool danger = true)
    {
        _tcs?.TrySetResult(false);
        _title = title;
        _message = message;
        _confirmText = confirmText;
        _danger = danger;
        _open = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private void Resolve(bool result)
    {
        if (!_open) return;
        _open = false;
        _tcs?.TrySetResult(result);
        StateHasChanged();
    }
}
